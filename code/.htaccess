# Public entry points: index.php, setup.php (first run only), pay.php, callback.php, webhook.php.
Options -Indexes
DirectoryIndex index.php

# Block config, samples, logs, databases and dotfiles.
<FilesMatch "^(config(\.sample)?\.php|.*\.(log|sqlite|sqlite-wal|sqlite-shm|md|tmp))$|^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
